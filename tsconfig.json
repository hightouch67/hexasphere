{
"compilerOptions": {
  "target": "ES2020",
  "lib": ["ES2020", "DOM"],
  "module": "ESNext",
  "moduleResolution": "node",
  "declaration": true,
  "outDir": "./dist",
  "rootDir": "./",
  "strict": true,
  "esModuleInterop": true,
  "skipLibCheck": true,
  "forceConsistentCasingInFileNames": true,
  "resolveJsonModule": true,
  "allowSyntheticDefaultImports": true,
  "types": ["three"]
},
  "include": [
    "src/**/*",
    "main.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
